# Planfix
PLANFIX_ACCOUNT=your-account
PLANFIX_WEBHOOK_URL=https://your-server.com/webhook/planfix
PLANFIX_NOTIFICATION_URL=https://your-account.planfix.com/rest/notification/chat
PLANFIX_TOKEN=generate-and-set-in-planfix

# Telegram
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=abcdef123456
TELEGRAM_PHONE=+380501234567
TELEGRAM_DATABASE_DIR=/data/telegram
TDJSON_PATH=

# TDLight memory optimizations (https://github.com/tdlight-team/tdlight)
# These reduce RAM usage for server-side integrations
TDLIGHT_DISABLE_MINITHUMBNAILS=true
TDLIGHT_DISABLE_DOCUMENT_FILENAMES=false
TDLIGHT_DISABLE_NOTIFICATIONS=true
TDLIGHT_DISABLE_GROUP_CALLS=true
TDLIGHT_DISABLE_AUTO_DOWNLOAD=true
TDLIGHT_IGNORE_SERVER_DELETES_AND_READS=true
TDLIGHT_IGNORE_UPDATE_CHAT_LAST_MESSAGE=false
TDLIGHT_IGNORE_UPDATE_CHAT_READ_INBOX=true
TDLIGHT_IGNORE_UPDATE_USER_CHAT_ACTION=true

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./data/integration.db
